<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: same exclusions as encrogram_backup_rules.xml, for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="encrogram_secured_keys.xml" />
        <exclude domain="sharedpref" path="encrogram_secured_ui.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="encrogram_secured_keys.xml" />
        <exclude domain="sharedpref" path="encrogram_secured_ui.xml" />
    </device-transfer>
</data-extraction-rules>
